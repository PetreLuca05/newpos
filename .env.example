# Port HTTP
PORT=3000
# Secret pentru codurile QR ale meselor (schimbați-l! dacă îl schimbați, reprintați QR-urile)
POS_SECRET=schimbati-acest-secret
# URL public folosit în codurile QR (ex. https://pos.exemplu.ro). Implicit: host-ul cererii.
PUBLIC_URL=
# Locațiile servite de acest proces (gol = toate). Ex: cluj,bucuresti
LOCATIONS=
# Supabase (opțional; fără el datele se salvează în ./data/<locatie>.json)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Retenție date personale (zile) până la anonimizare
RETENTION_DAYS=30
# Sincronizare automată ANAF / TEDB / BNR (0 = oprit)
LEGAL_SYNC=1
# Curs EUR de rezervă dacă BNR nu răspunde
EUR_RATE=5.0
# Driver casă de marcat per locație: simulated | file | http  (vezi src/devices.js)
CLUJ_FISCAL_DRIVER=simulated
BUCURESTI_FISCAL_DRIVER=simulated
